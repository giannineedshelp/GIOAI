# GIOAI Discord Bot Configuration
# Copy this to .env and fill in your values

# REQUIRED: Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# REQUIRED: Discord Client/Application ID
CLIENT_ID=your_application_id_here

# Your Discord User ID (for owner-only commands)
OWNER_ID=your_discord_user_id_here

# Guild/server ID for slash commands
GUILD_ID=your_guild_id_here

# Channel IDs
STATUS_CHANNEL_ID=channel_id_for_status_updates
LEARNING_CHANNEL_ID=channel_id_for_faq_embed

# Role IDs
BASE_ROLE_ID=base_member_role_id
STAFF_ROLE_ID=staff_role_id

# Worker URL (Cloudflare worker for platform APIs)
WORKER_URL=https://gioai.giannikei12.workers.dev

# GitHub token (for auto-push features)
GITHUB_TOKEN=your_github_token_here

